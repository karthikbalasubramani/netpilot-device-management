APP_NAME=NetPilot
APP_ENV=local
APP_PORT=8080

LOG_LEVEL=debug

API_LOG_ENABLED=true
API_LOG_FILE_PATH=logs/api.log
API_LOG_MAX_SIZE_MB=10
API_LOG_MAX_BACKUPS=5
API_LOG_MAX_AGE_DAYS=30
API_LOG_COMPRESS=true

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=netpilot_db

JWT_SECRET=change_me
MQTT_BROKER=tcp://localhost:1883

CPU_THRESHOLD_PERCENT=60
DISK_PATH=C:

HTTP_READ_HEADER_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=60
HTTP_MAX_HEADER_BYTES=1048576